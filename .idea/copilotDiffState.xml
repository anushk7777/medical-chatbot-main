              <option name="updatedContent" value="&lt;!doctype html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;  &lt;meta charset=&quot;utf-8&quot;&gt;&#10;  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1&quot;&gt;&#10;  &lt;title&gt;MediBot&lt;/title&gt;&#10;  &lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.googleapis.com&quot;&gt;&#10;  &lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.gstatic.com&quot; crossorigin&gt;&#10;  &lt;link href=&quot;https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&amp;family=Space+Grotesk:wght@400;500;700&amp;display=swap&quot; rel=&quot;stylesheet&quot;&gt;&#10;  &lt;link rel=&quot;stylesheet&quot; href=&quot;/styles.css&quot;&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;div class=&quot;page-shell&quot;&gt;&#10;    &lt;div class=&quot;glow glow-a&quot;&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;glow glow-b&quot;&gt;&lt;/div&gt;&#10;&#10;    &lt;header class=&quot;hero&quot;&gt;&#10;      &lt;div class=&quot;hero-copy&quot;&gt;&#10;        &lt;p class=&quot;eyebrow&quot;&gt;Medical Assistant&lt;/p&gt;&#10;        &lt;h1&gt;MediBot&lt;/h1&gt;&#10;        &lt;p class=&quot;hero-text&quot;&gt;&#10;          Chat with the medical knowledge base, run a lightweight symptom check,&#10;          and use the built-in mental health assessment tools from a single deployed app.&#10;        &lt;/p&gt;&#10;        &lt;div class=&quot;hero-tags&quot;&gt;&#10;          &lt;span&gt;Chat RAG&lt;/span&gt;&#10;          &lt;span&gt;Disease Predictor&lt;/span&gt;&#10;          &lt;span&gt;PHQ-9&lt;/span&gt;&#10;          &lt;span&gt;Risk Insights&lt;/span&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;      &lt;aside class=&quot;hero-panel&quot;&gt;&#10;        &lt;h2&gt;Before you rely on an answer&lt;/h2&gt;&#10;        &lt;ul&gt;&#10;          &lt;li&gt;This app is informational, not a diagnosis.&lt;/li&gt;&#10;          &lt;li&gt;Urgent symptoms need urgent clinical care.&lt;/li&gt;&#10;          &lt;li&gt;Predictions are probability-based, not definitive.&lt;/li&gt;&#10;        &lt;/ul&gt;&#10;      &lt;/aside&gt;&#10;    &lt;/header&gt;&#10;&#10;    &lt;nav class=&quot;tab-bar&quot; aria-label=&quot;App sections&quot;&gt;&#10;      &lt;button class=&quot;tab-button active&quot; data-tab=&quot;chat&quot;&gt;Chat&lt;/button&gt;&#10;      &lt;button class=&quot;tab-button&quot; data-tab=&quot;predictor&quot;&gt;Disease Predictor&lt;/button&gt;&#10;      &lt;button class=&quot;tab-button&quot; data-tab=&quot;phq9&quot;&gt;PHQ-9&lt;/button&gt;&#10;      &lt;button class=&quot;tab-button&quot; data-tab=&quot;insights&quot;&gt;Mental Health Insights&lt;/button&gt;&#10;    &lt;/nav&gt;&#10;&#10;    &lt;main&gt;&#10;      &lt;section class=&quot;panel active&quot; id=&quot;panel-chat&quot;&gt;&#10;        &lt;div class=&quot;panel-head&quot;&gt;&#10;          &lt;div&gt;&#10;            &lt;p class=&quot;panel-kicker&quot;&gt;Knowledge Base Chat&lt;/p&gt;&#10;            &lt;h2&gt;Ask a medical question&lt;/h2&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;chip-row&quot;&gt;&#10;            &lt;button class=&quot;chip prompt-chip&quot; data-prompt=&quot;What is depression?&quot;&gt;What is depression?&lt;/button&gt;&#10;            &lt;button class=&quot;chip prompt-chip&quot; data-prompt=&quot;What causes fever?&quot;&gt;What causes fever?&lt;/button&gt;&#10;            &lt;button class=&quot;chip prompt-chip&quot; data-prompt=&quot;How is migraine treated?&quot;&gt;How is migraine treated?&lt;/button&gt;&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;&#10;&#10;        &lt;div class=&quot;chat-layout&quot;&gt;&#10;          &lt;div class=&quot;chat-card&quot;&gt;&#10;            &lt;div id=&quot;chatMessages&quot; class=&quot;chat-messages&quot; aria-live=&quot;polite&quot;&gt;&lt;/div&gt;&#10;            &lt;form id=&quot;chatForm&quot; class=&quot;chat-form&quot;&gt;&#10;              &l