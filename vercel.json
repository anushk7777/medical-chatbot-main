{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install --upgrade pip && pip install -r requirements-vercel.txt",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "cleanUrls": true
}
