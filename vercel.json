{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
